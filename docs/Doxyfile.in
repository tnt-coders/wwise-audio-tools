# Wwise Audio Tools' documentation: README.md as the main page, and the library's public API. The
# root CMakeLists.txt states the input (PROJECT_CONFIG_DOCS_INPUT), and project-config the output
# folder and the house look. Only the tags that differ from Doxygen's defaults are listed.

PROJECT_NAME           = "@PROJECT_NAME@"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "@PROJECT_DESCRIPTION@"

USE_MDFILE_AS_MAINPAGE = @CMAKE_SOURCE_DIR@/README.md

# The public headers sit in include/wwtools, a folder below the input folder.
RECURSIVE              = YES
